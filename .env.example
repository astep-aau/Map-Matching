# Copy to .env. Without a .env file the same defaults are used.
# .env is git-ignored - never commit real passwords.
#
# The database itself is configured in the data repository's .env
# (POSTGRES_DB / POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_PORT).
# The values below must match it.

# - when running directly on your machine (python / mapmatch):
DB_HOST=localhost
DB_PORT=5432
DB_NAME=data
DB_USER=postgres
DB_PASSWORD=postgres

# - when running in Docker (docker compose run mapmatching ...):
#   host.docker.internal = the database the data repository publishes on
#   your machine. Set to the shared aSTEP database host to run against
#   that instead (read-only commands only, as agreed in Scrum of Scrums).
DOCKER_DB_HOST=host.docker.internal
# Same as POSTGRES_PORT in the data repository's .env
DOCKER_DB_PORT=5432

# Memory limit for the mapmatching container (see compose.yaml)
# MAPMATCH_MEM_LIMIT=2g
